# MongoDB is required — SQLite is not supported by the application.
DATABASE_BACKEND=mongodb
# Required: connection string. Include authSource. Add replicaSet=rs0 when available.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/DATABASE?authSource=DATABASE
# Required: database name for application collections.
MONGODB_DATABASE=your_app_database

# Public HTTPS origin serving this backend. Uploaded images and PDFs use URLs
# under this domain. A private 10.x address is not reachable by WhatsApp.
PUBLIC_BASE_URL=https://chatbot.example.com
IMAGE_BASE_URL=https://chatbot.example.com

# Run document/PDF bifurcation on the local Ollama service.
BIFURCATE_PROVIDER=ollama
BIFURCATE_OLLAMA_MODEL=qwen2.5:1.5b
# Fast ingestion profile: one larger window, GPU offload, and enough reserved
# time for vector/FAQ indexing to keep typical uploads below two minutes.
BIFURCATE_OLLAMA_NUM_GPU=99
BIFURCATE_OLLAMA_TIMEOUT=70
BIFURCATE_TOTAL_TIMEOUT_SECONDS=75
BIFURCATE_CHUNK_CHARS=18000
BIFURCATE_CHUNK_OVERLAP=250
BIFURCATE_NUM_PREDICT=1536
