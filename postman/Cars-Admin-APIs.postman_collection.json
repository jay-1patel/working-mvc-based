          "name": "GET status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/status"
          }
        },
        {
          "name": "POST login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"session_id\": \"{{session_id}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "header": [
