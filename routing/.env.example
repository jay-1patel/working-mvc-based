# MongoDB is required — SQLite is not supported by the application.
DATABASE_BACKEND=mongodb
# Required: connection string. Include authSource. Add replicaSet=rs0 when available.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/DATABASE?authSource=DATABASE
# Required: database name for application collections.
MONGODB_DATABASE=your_app_database

# Production security controls.
APP_ENV=production
META_APP_SECRET=your_meta_app_secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=your_fernet_key
# Platform-wide Send2 credential vault master key (32 random bytes, base64).
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Never reuse SEND2_API_KEY/SECRET or GOOGLE_TOKEN_ENCRYPTION_KEY.
CREDENTIAL_MASTER_KEY=
# Use the legacy global SEND2_USERNAME/SEND2_PASSWORD only when a tenant has no vault record.
SEND2_VAULT_FALLBACK=false
# Optional — fill when Send2 documents the per-customer credential API.
SEND2_CREDENTIALS_API_URL=
SEND2_CREDENTIALS_API_KEY=
SEND2_CREDENTIALS_API_SECRET=
# Only set true in local/test environments using a single WhatsApp number.
ALLOW_TEST_TENANT_OVERRIDE=false

# Cloudflare (or other public HTTPS) origin for WhatsApp PDFs + photos.
# Update ONLY this when the tunnel URL changes, then restart the backend.
# Example: https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=https://chatbot.example.com
# Optional legacy alias — leave blank; images use PUBLIC_BASE_URL.
IMAGE_BASE_URL=

# Run document/PDF bifurcation on the local Ollama service.
BIFURCATE_PROVIDER=ollama
BIFURCATE_OLLAMA_MODEL=qwen3:8b
# Fast ingestion profile: one larger window, GPU offload, and enough reserved
# time for vector/FAQ indexing to keep typical uploads below two minutes.
BIFURCATE_OLLAMA_NUM_GPU=99
BIFURCATE_OLLAMA_TIMEOUT=70
BIFURCATE_TOTAL_TIMEOUT_SECONDS=75
BIFURCATE_CHUNK_CHARS=18000
BIFURCATE_CHUNK_OVERLAP=250
BIFURCATE_NUM_PREDICT=1536
